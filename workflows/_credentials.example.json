[
  {
    "id": "wip-pg-cred-0001",
    "name": "WIP Postgres",
    "type": "postgres",
    "data": {
      "host": "aws-0-<region>.pooler.supabase.com",
      "port": 5432,
      "database": "postgres",
      "user": "postgres.<your-project-ref>",
      "password": "<YOUR_SUPABASE_DB_PASSWORD>",
      "ssl": "require",
      "allowUnauthorizedCerts": true,
      "maxConnections": 5
    }
  },
  {
    "id": "wip-smtp-cred-0001",
    "name": "WIP SMTP",
    "type": "smtp",
    "data": {
      "user": "<your-gmail-address>",
      "password": "<16-char-gmail-app-password>",
      "host": "smtp.gmail.com",
      "port": 465,
      "secure": true,
      "disableStartTls": false
    }
  },
  {
    "id": "wip-gemini-cred-0001",
    "name": "WIP Gemini Key",
    "type": "httpHeaderAuth",
    "data": {
      "name": "X-goog-api-key",
      "value": "<YOUR_GEMINI_API_KEY>"
    }
  },
  {
    "id": "wip-twilio-http-0001",
    "name": "WIP Twilio Basic",
    "type": "httpBasicAuth",
    "data": {
      "user": "<YOUR_TWILIO_ACCOUNT_SID>",
      "password": "<YOUR_TWILIO_AUTH_TOKEN>"
    }
  }
]
