# Copy to .env and fill in. Used by docker-compose.
# This local Postgres only stores n8n's own metadata (not app data).
POSTGRES_USER=wip
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=wip

# The n8n owner account is created on first launch (browser or scripts/setup).
# The Supabase application-database credentials are stored INSIDE n8n —
# see workflows/_credentials.example.json.
#
# API keys (Gemini, Gmail SMTP, Twilio) are NOT stored here — they live only in
# n8n credentials, which are exported to workflows/_credentials.json (git-ignored).

# --- Notification config (WF-19) ---
WIP_MAIL_FROM=you@example.com
WIP_DEMO_INBOX=you@example.com
WIP_DEMO_WHATSAPP=+15555550123
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
