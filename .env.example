# Copy to .env and fill in. Used by docker-compose.
# This local Postgres only stores n8n's own metadata (not app data).
POSTGRES_USER=wip
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=wip

# The n8n owner account is created on first launch (browser or scripts/setup).
# The Supabase application-database credentials are stored INSIDE n8n —
# see workflows/_credentials.example.json.
